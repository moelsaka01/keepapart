{
    "version": "{{VERSION}}",
    "description": "One machine, many Claude & Codex accounts. Work, personal, clients, kept apart.",
    "homepage": "https://github.com/moelsaka01/keepapart",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/moelsaka01/keepapart/releases/download/v{{VERSION}}/keepapart-v{{VERSION}}-x86_64-pc-windows-msvc.zip",
            "hash": "{{SHA256:x86_64-pc-windows-msvc}}",
            "extract_dir": "keepapart-v{{VERSION}}-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/moelsaka01/keepapart/releases/download/v{{VERSION}}/keepapart-v{{VERSION}}-aarch64-pc-windows-msvc.zip",
            "hash": "{{SHA256:aarch64-pc-windows-msvc}}",
            "extract_dir": "keepapart-v{{VERSION}}-aarch64-pc-windows-msvc"
        }
    },
    "bin": "keepapart.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moelsaka01/keepapart/releases/download/v$version/keepapart-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "keepapart-v$version-x86_64-pc-windows-msvc"
